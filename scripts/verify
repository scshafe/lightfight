#!/usr/bin/env bash
# The repository's one verify command (dev.toml [verify]): the repository
# tests, then each part's tests when the part has them. CI runs the same
# command. A part joins by adding the file named below; nothing else changes.
#   firmware/Makefile  -> host tests of the portable C library (make test)
#   server/go.mod      -> go vet and go test
#   ios/Package.swift  -> swift test, only where swift is installed (skipped
#                         otherwise; CI's runner has none, see ios/README.md)
set -euo pipefail
cd "$(dirname "$0")/.."

python3 -B -m unittest discover -s tests -t . -v

if [ -f firmware/Makefile ]; then
  echo "== firmware host tests"
  make -C firmware test
fi

if [ -f server/go.mod ]; then
  echo "== server tests"
  (cd server && go vet ./... && go test ./...)
fi

if [ -f ios/Package.swift ]; then
  if command -v swift >/dev/null 2>&1; then
    echo "== ios package tests"
    (cd ios && swift test)
  else
    echo "== ios package tests skipped: swift is not installed"
  fi
fi
