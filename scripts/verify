#!/usr/bin/env bash
# The repository's one verify command (dev.toml [verify]): run the repository
# tests with the standard library's unittest. CI runs the same command. The
# firmware, ios and server parts add their own builds and tests here once the
# design is accepted.
set -euo pipefail
cd "$(dirname "$0")/.."

python3 -B -m unittest discover -s tests -t . -v
